{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on-prompt.sh\"",
            "timeout": 15
          }
        ],
        "description": "Log user input with timestamp and push to remote repo"
      }
    ]
  }
}
